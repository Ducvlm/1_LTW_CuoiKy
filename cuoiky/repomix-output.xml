              {loading ? 'Đang xác thực...' : 'Đăng nhập'}
            </button>
          </form>
        </div>

        <p className="text-center text-sm text-slate-500 mt-6">
          Chưa có tài khoản?{' '}
          <Link to="/register" className="text-indigo-600 font-medium hover:text-indigo-700 hover:underline">
