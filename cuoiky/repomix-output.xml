/* ======================= TRANG CHÍNH ======================= */
const AdminDashboard = () => {
  const [activeMenu, setActiveMenu] = useState('overview');
  const [sidebarOpen, setSidebarOpen] = useState(() => window.innerWidth >= 1024);
  const [chartRange, setChartRange] = useState('7d');
  const [globalSearch, setGlobalSearch] = useState('');

  const [users, setUsers] = useState([]);
  const [subjects, setSubjects] = useState([]);
  const [serverStats, setServerStats] = useState({ totalExams: 0, totalQuestions: 0 });
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const [roleFilter, setRoleFilter] = useState('all');
  const [statusFilter, setStatusFilter] = useState('all');

  const [showAddUser, setShowAddUser] = useState(false);
  const [newUser, setNewUser] = useState({ username: '', email: '', password: '', role: 'teacher' });
  const [editingUser, setEditingUser] = useState(null);

  const [subjectForm, setSubjectForm] = useState({ subjectCode: '', name: '' });
  const [editingSubjectId, setEditingSubjectId] = useState(null);

  const [confirmTarget, setConfirmTarget] = useState(null);
  const [confirming, setConfirming] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const { toasts, pushToast, dismissToast } = useToasts();

  const navigate = useNavigate();
  const currentUser = JSON.parse(localStorage.getItem('user') || '{}');

  const fetchData = useCallback(async (isManualRefresh = false) => {
  if (isManualRefresh) setRefreshing(true);
  else setLoading(true);

  try {
    const [usersData, subjectsData, statsData] = await Promise.all([
      axiosClient.get('/admin/users'),
      axiosClient.get('/admin/subjects'),
      axiosClient.get('/admin/stats'),
    ]);

    setUsers(Array.isArray(usersData) ? usersData : []);
    setSubjects(Array.isArray(subjectsData) ? subjectsData : []);
    if (statsData) {
      setServerStats({
        totalExams: statsData.totalExams || 0,
        totalQuestions: statsData.totalQuestions || 0,
      });
    }
  } catch (err) {
    console.error('Lỗi tải dữ liệu:', err);
    pushToast('error', err.message);
  } finally {
    setLoading(false);
    setRefreshing(false);
  }
}, [pushToast]);

useEffect(() => {
  fetchData();
}, [fetchData]);

  const stats = useMemo(() => {
    const totalUsers = users.length;
    const students = users.filter(u => u.role === 'student').length;
    const teachers = users.filter(u => u.role === 'teacher').length;
    const admins = users.filter(u => u.role === 'admin').length;
    const locked = users.filter(u => u.isActive === false).length;
    const active = totalUsers - locked;
    return {
      totalUsers,
      students,
      teachers,
      admins,
      locked,
      active,
      totalSubjects: subjects.length,
      totalExams: serverStats.totalExams,
      totalQuestions: serverStats.totalQuestions,
    };
  }, [users, subjects, serverStats]);

  // Đếm chính xác số tài khoản đăng ký trong từng ngày (7d) hoặc từng cụm 3 ngày (30d)
  const chartData = useMemo(() => {
    const is7d = chartRange === '7d';
    const steps = is7d ? 7 : 10;
    const stepDays = is7d ? 1 : 3;
    const dayLabels = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
    const result = [];
    const now = new Date();
    now.setHours(23, 59, 59, 999);

    for (let i = steps - 1; i >= 0; i--) {
      const endWindow = new Date(now);
      endWindow.setDate(now.getDate() - i * stepDays);

      const startWindow = new Date(endWindow);
      startWindow.setDate(endWindow.getDate() - (stepDays - 1));
      startWindow.setHours(0, 0, 0, 0);

      const label = is7d
        ? dayLabels[endWindow.getDay()]
        : `${endWindow.getDate()}/${endWindow.getMonth() + 1}`;

      const count = users.filter(u => {
        if (!u.createdAt) return false;
        const created = new Date(u.createdAt);
        return created >= startWindow && created <= endWindow;
      }).length;

      result.push({ label, value: count });
    }
    return result;
  }, [users, chartRange]);

  const filteredUsers = useMemo(() => {
    return users.filter(u => {
      const matchSearch =
        u.username?.toLowerCase().includes(globalSearch.toLowerCase()) ||
        u.email?.toLowerCase().includes(globalSearch.toLowerCase());
      const matchRole = roleFilter === 'all' || u.role === roleFilter;
      const matchStatus =
        statusFilter === 'all' ||
        (statusFilter === 'active' && u.isActive !== false) ||
        (statusFilter === 'locked' && u.isActive === false);
      return matchSearch && matchRole && matchStatus;
    });
  }, [users, globalSearch, roleFilter, statusFilter]);

  const filteredSubjects = useMemo(() => {
    return subjects.filter(s =>
      s.subjectCode?.toLowerCase().includes(globalSearch.toLowerCase()) ||
      s.name?.toLowerCase().includes(globalSearch.toLowerCase())
    );
  }, [subjects, globalSearch]);

  /* ---------- HÀNH ĐỘNG VỚI API ---------- */
  const handleCreateUser = async (e) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      const data = await axiosClient.post('/admin/users', newUser);
      setNewUser({ username: '', email: '', password: '', role: 'teacher' });
      setShowAddUser(false);
      pushToast('success', data.message || 'Tạo tài khoản thành công!');
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    } finally {
      setSubmitting(false);
    }
  };

  const handleRoleChange = async (user, newRole) => {
    try {
      const data = await axiosClient.put(`/admin/users/${user._id}`, {
        username: user.username,
        email: user.email,
        role: newRole
      });
      pushToast('success', data.message || 'Cập nhật người dùng thành công!');
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    }
  };

  const handleUpdateUserSubmit = async (e) => {
    e.preventDefault();
    if (!editingUser) return;
    setSubmitting(true);
    try {
      const data = await axiosClient.put(`/admin/users/${editingUser._id}`, {
        username: editingUser.username,
        email: editingUser.email,
        role: editingUser.role,
        password: editingUser.password
      });
      setEditingUser(null);
      pushToast('success', data.message || 'Cập nhật tài khoản thành công!');
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    } finally {
      setSubmitting(false);
    }
  };

  const handleToggleStatus = async (id) => {
    try {
      const data = await axiosClient.patch(`/admin/users/${id}/toggle-status`);
      pushToast('success', data.message);
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    }
  };

  const handleDeleteUser = async (id) => {
    try {
      const data = await axiosClient.delete(`/admin/users/${id}`);
      pushToast('success', data.message || 'Đã xóa người dùng thành công!');
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    }
  };

  const handleSubjectSubmit = async (e) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      const data = editingSubjectId
        ? await axiosClient.put(`/admin/subjects/${editingSubjectId}`, subjectForm)
        : await axiosClient.post('/admin/subjects', subjectForm);
      setSubjectForm({ subjectCode: '', name: '' });
      setEditingSubjectId(null);
      pushToast('success', data.message);
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    } finally {
      setSubmitting(false);
    }
  };

  const handleDeleteSubject = async (id) => {
    try {
      const data = await axiosClient.delete(`/admin/subjects/${id}`);
      pushToast('success', data.message || 'Đã xóa môn học thành công!');
      fetchData(true);
    } catch (err) {
      pushToast('error', err.message);
    }
  };

  const handleConfirmDelete = async () => {
    if (!confirmTarget) return;
    setConfirming(true);
    if (confirmTarget.kind === 'user') {
      await handleDeleteUser(confirmTarget.id);
    } else {
      await handleDeleteSubject(confirmTarget.id);
    }
    setConfirming(false);
    setConfirmTarget(null);
  };

  const handleLogout = () => {
    localStorage.clear();
    navigate('/login');
  };

  const handleMenuClick = (id) => {
    setActiveMenu(id);
    if (window.innerWidth < 1024) setSidebarOpen(false);
  };

  /* ---------- BIỂU ĐỒ ---------- */
  const renderAreaChart = () => {
    const width = 620;
    const height = 220;
    const padX = 36;
    const padY = 28;
    const rawMax = Math.max(...chartData.map(d => d.value), 0);
    const maxVal = Math.max(4, Math.ceil(rawMax / 4) * 4);

    const points = chartData.map((d, idx) => {
      const x = padX + (idx * (width - padX * 2)) / Math.max(chartData.length - 1, 1);
      const y = height - padY - (d.value / maxVal) * (height - padY * 2);
      return { x, y, ...d };
    });

    let pathD = `M ${points[0].x} ${points[0].y}`;
    for (let i = 0; i < points.length - 1; i++) {
      const curr = points[i];
      const next = points[i + 1];
      const ctrlX = (curr.x + next.x) / 2;
      pathD += ` C ${ctrlX} ${curr.y}, ${ctrlX} ${next.y}, ${next.x} ${next.y}`;
    }

    const areaD = `${pathD} L ${points[points.length - 1].x} ${height - padY} L ${points[0].x} ${height - padY} Z`;

    return (
      <svg viewBox={`0 0 ${width} ${height}`} className="w-full h-auto overflow-visible">
        <defs>
          <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#4f46e5" stopOpacity="0.18" />
            <stop offset="100%" stopColor="#4f46e5" stopOpacity="0" />
          </linearGradient>
        </defs>

        {[0, 0.25, 0.5, 0.75, 1].map((ratio, idx) => {
          const y = height - padY - ratio * (height - padY * 2);
          const val = Math.round(ratio * maxVal);
          return (
            <g key={idx}>
              <line x1={padX} y1={y} x2={width - padX} y2={y} stroke="#e2e8f0" strokeWidth="1" strokeDasharray={ratio === 0 ? '0' : '3 4'} />
              <text x={padX - 10} y={y + 4} textAnchor="end" fontSize="11" fill="#94a3b8">{val}</text>
            </g>
          );
        })}

        <path d={areaD} fill="url(#areaGrad)" />
        <path d={pathD} fill="none" stroke="#4f46e5" strokeWidth="2.5" strokeLinecap="round" />

        {points.map((p, idx) => (
          <g key={idx}>
            <circle cx={p.x} cy={p.y} r="4" fill="#4f46e5" stroke="#fff" strokeWidth="2">
              <title>{`${p.label}: ${p.value} tài khoản`}</title>
            </circle>
            <text x={p.x} y={height - 6} textAnchor="middle" fontSize="11" fill="#64748b">{p.label}</text>
          </g>
        ))}
      </svg>
    );
  };

  const renderDonutChart = () => {
    const total = Math.max(stats.totalUsers, 1);
    const segments = [
      { label: 'Thí sinh', value: stats.students, color: '#4f46e5' },
      { label: 'Giảng viên', value: stats.teachers, color: '#38bdf8' },
      { label: 'Quản trị viên', value: stats.admins, color: '#94a3b8' }
    ];

    const radius = 56;
    const circumference = 2 * Math.PI * radius;
    let offsetAcc = 0;
    const arcs = segments.map(seg => {
      const len = (seg.value / total) * circumference;
      const arc = { ...seg, len, offset: offsetAcc };
      offsetAcc += len;
      return arc;
    });

    return (
      <div className="flex flex-col items-center">
        <div className="relative w-40 h-40">
          <svg viewBox="0 0 156 156" className="-rotate-90 w-full h-full">
            <circle cx="78" cy="78" r={radius} fill="transparent" stroke="#f1f5f9" strokeWidth="18" />
            {arcs.map((arc, idx) =>
              arc.value === 0 ? null : (
                <circle
