const express = require('express');
const router = express.Router();
const { verifyToken, verifyRole } = require('../middleware/authMiddleware');
const {
    getDashboardStats,
    getAllUsers,
    createUser,
    updateUser,
    toggleUserStatus,
    deleteUser,
    getAllSubjects,
    createSubject,
    updateSubject,
    deleteSubject
} = require('../controllers/adminController');

